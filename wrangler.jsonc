{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "espacioseed",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "espacioseed-db",
      "database_id": "5c9226a6-4e85-4401-a28b-5a8edace4f3d",
      "migrations_dir": "drizzle"
    }
  ]
}
